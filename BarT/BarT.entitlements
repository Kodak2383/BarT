<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	IMPORTANT: the App Sandbox is DISABLED.
	Reason: BarT drives other applications' processes through the macOS Accessibility API.
	The App Sandbox does not permit that kind of control (for security reasons).
	The sandbox therefore has to be disabled explicitly here.
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	WICHTIG: App Sandbox ist DEAKTIVIERT.
	Grund: BarT steuert fremde Anwendungsprozesse über die macOS Accessibility API.
	Die App Sandbox erlaubt solche Kontrolle nicht (aus Sicherheitsgründen).
	Daher muss die Sandbox hier explizit deaktiviert werden.
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>

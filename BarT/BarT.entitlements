<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	IMPORTANT: the App Sandbox is DISABLED.
	Reason: BarT reads the menu bar's window list through private CoreGraphics Services calls
	(see Bridging.swift). A sandboxed process cannot reach them, and it cannot read the
	system's own shortcut list in com.apple.symbolichotkeys either (see GlobalHotKey.swift).
	This used to name the Accessibility API, which BarT stopped using in BT-15.
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>
</dict>
</plist>
